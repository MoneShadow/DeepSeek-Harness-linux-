{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness Desktop — 内嵌 cc-tui 终端与会话侧栏的桌面客户端",
  "main": "main.js",
  "author": "mone",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "selfcheck": "DSH_DESKTOP_SELFCHECK=1 electron .",
    "dist": "electron-builder --linux AppImage",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "mone",
      "synopsis": "DeepSeek Harness 桌面客户端"
    }
  }
}
