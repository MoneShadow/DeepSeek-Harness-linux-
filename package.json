{
  "name": "dsh-desktop",
  "version": "0.4.0",
  "description": "DSH Desktop — 内嵌官方 DeepSeek Harness Web UI 的桌面客户端（含自动更新）",
  "main": "main.js",
  "author": "mone",
  "license": "MIT",
  "desktopName": "dsh-desktop",
  "scripts": {
    "start": "electron .",
    "selfcheck": "DSH_DESKTOP_SELFCHECK=1 electron .",
    "selfcheck-crash": "DSH_DESKTOP_SELFCHECK=1 DSH_DESKTOP_SELFCHECK_CRASH=1 electron .",
    "test": "node --test",
    "dist": "electron-builder --linux AppImage"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "mone",
      "synopsis": "DeepSeek Harness 桌面客户端",
      "syncDesktopName": true
    }
  }
}
